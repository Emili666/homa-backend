# ============================================================
# HOMA Backend — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA subas el .env al repositorio
# ============================================================

# Base de datos
DB_HOST=tu_host_db
DB_PORT=3306
DB_NAME=homa_db
DB_USERNAME=homa_user
DB_PASSWORD=contraseña_segura
DB_USE_SSL=true

# JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# JWT (mínimo 32 caracteres, generado aleatoriamente)
# Genera uno con: openssl rand -base64 48
JWT_SECRET=genera-un-secreto-aleatorio-seguro-aqui
JWT_EXPIRATION=3600000

# Correo (usa una App Password de Google, no tu contraseña real)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_16_caracteres

# URLs
FRONTEND_BASE_URL=https://tu-frontend.com
BACKEND_BASE_URL=https://tu-backend.com
CORS_ALLOWED_ORIGINS=https://tu-frontend.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Mercado Pago
# Obtener en: https://www.mercadopago.com.co/developers/panel
MERCADO_PAGO_ACCESS_TOKEN=TEST-tu_access_token
MERCADO_PAGO_PUBLIC_KEY=TEST-tu_public_key
MERCADO_PAGO_BACK_URL_SUCCESS=http://localhost:4200/success
MERCADO_PAGO_BACK_URL_PENDING=http://localhost:4200/pending
MERCADO_PAGO_BACK_URL_FAILURE=http://localhost:4200/failure

# Cloudflare Turnstile
TURNSTILE_SECRET=tu_turnstile_secret

# Administrador inicial
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=ContraseñaSegura123!

# Grafana Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=contraseña_grafana_segura
GRAFANA_ROOT_URL=http://tu-servidor:3030

# Prometheus
HOMA_BACKEND_HOST=tu-backend.com

# SonarQube
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=tu_sonar_token
